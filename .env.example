# Copy to .env (local runs) or add as GitHub Actions secrets (cloud runs). Never commit .env.

# --- Telegram (required) ---
# Create a bot with @BotFather -> token. Send your bot any message, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates   and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LinkedIn / Naukri / Indeed saved-search emails (optional, recommended) ---
# Gmail: turn on 2-step verification, then create an App Password at
# myaccount.google.com/apppasswords. A dedicated Gmail account is best.
ALERT_EMAIL_ADDRESS=
ALERT_EMAIL_APP_PASSWORD=

# --- Optional keyed job APIs (both free) ---
# Adzuna: developer.adzuna.com    Jooble: jooble.org/api/about
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
