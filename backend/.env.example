# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit it.

# --- Database ---
# Postgres connection string. For local dev, `docker compose up -d` (see
# backend/docker-compose.yml) starts a Postgres+pgvector container matching
# the value below. In production, VM1 points this at VM2's private IP; VM2
# points it at its own local Postgres (127.0.0.1) -- see deploy/oci_deploy_*.sh.
DATABASE_URL=postgresql://job_alert:job_alert@localhost:5433/job_alert

# --- Accounts ---
# Each user signs up their own account (email + password) and configures their
# own keyword filters, ingestion sources, and Telegram/Slack/Discord
# notification channels through the app -- none of that is an env var anymore.
#
# SIGNUP_INVITE_CODE gates account creation only (every other endpoint requires
# a real per-user login instead). Unset by default -- open signup, fine while
# the backend is only reachable at 127.0.0.1. Set this once the backend is
# reachable beyond your own machine (e.g. bound to 0.0.0.0 for phone access,
# see bot_docs/OPERATIONS.md) so a stranger who finds the URL can't just create
# an account; share the same value with whoever you actually want signing up.
# SIGNUP_INVITE_CODE=
# Session token lifetime in days -- how long a login lasts before needing to
# sign in again. 30 by default.
# SESSION_TTL_DAYS=30
# CORS origin allowed to call the API cross-origin -- only matters for native
# Flutter builds (Windows/Android/iOS) and local browser dev against a
# separate-origin backend; the deployed web build hits the API same-origin
# through nginx, which CORS doesn't apply to at all. "*" (open) by default;
# set to your real deployed origin, e.g. https://job-alert-app.duckdns.org,
# once this is reachable beyond 127.0.0.1.
# ALLOWED_ORIGIN=*

# --- Resume parsing / AI (Gemini free tier) ---
# Free API key from aistudio.google.com -- required for resume upload
# (POST /resume) and job matching (GET /matches). Both fail with a clear
# error, not a crash, if this is unset.
GOOGLE_API_KEY=
# Model ids -- working defaults below, only set if you want to change them.
# GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# Per-user resume uploads/day -- protects the free Gemini quota. 5 by default.
# RESUME_UPLOAD_DAILY_CAP=5

# --- Rate limiting ---
# Per-IP limits on account creation/login -- what actually stands between a
# public deployment (open signup by default) and someone scripting account
# creation or password-guessing. `limits`-library syntax. Working defaults
# below, only set if you want to change them.
# SIGNUP_RATE_LIMIT=5/hour
# LOGIN_RATE_LIMIT=10/15minute

# --- Alert inbox (for LinkedIn/Naukri saved-search email alerts) ---
# A dedicated inbox is recommended -- don't reuse your primary email.
ALERT_EMAIL_ADDRESS=
# For Gmail: an App Password (myaccount.google.com/apppasswords), not your normal password.
ALERT_EMAIL_APP_PASSWORD=
# Only needed if not using Gmail.
# ALERT_EMAIL_IMAP_HOST=imap.gmail.com
# ALERT_EMAIL_IMAP_PORT=993

# Only needed if the alert emails come from a different address than the defaults.
# LINKEDIN_ALERT_SENDER=jobalerts-noreply@linkedin.com
# NAUKRI_ALERT_SENDER=noreply@naukri.com
# INDEED_ALERT_SENDER=jobalert.indeed.com

# Optionally, also search a Gmail label (IMAP mailbox) alongside INBOX -- useful if
# you have a Gmail filter routing these alerts into a label. Must be enabled per-label
# under Gmail Settings -> Labels -> "Show in IMAP", and the exact name (case/spacing)
# matters -- check with an IMAP LIST call if unsure, don't just guess from the filter UI.
# LINKEDIN_ALERT_LABEL=Linkedin Alerts
# NAUKRI_ALERT_LABEL=Naukri Alerts
# INDEED_ALERT_LABEL=Indeed Alerts

# --- Tier-A RSS/JSON sources ---
# WeWorkRemotely, Himalayas, Remotive, NoDesk, Jobspresso, RemoteOK all have working
# defaults baked into config.py -- only set these if you want a different feed/category.
# WEWORKREMOTELY_FEED_URL=
# HIMALAYAS_FEED_URL=
# REMOTIVE_FEED_URL=
# NODESK_FEED_URL=
# JOBSPRESSO_FEED_URL=
# REMOTEOK_API_URL=

# --- Tier-A keyed aggregator APIs ---
# Arbeitnow needs no key at all -- registers automatically when the RSS toggle is on.
# Adzuna: free key at developer.adzuna.com. Jooble: free key at jooble.org/api/about.
# The Muse: works unauthenticated at low volume; key is optional, only raises the rate limit.
# Each needs its *_SEARCH_QUERIES (or THEMUSE_CATEGORIES) set -- one adapter per query/category.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=in
# ADZUNA_SEARCH_QUERIES=python,devops
# JOOBLE_API_KEY=
# JOOBLE_SEARCH_QUERIES=python,devops
# JOOBLE_LOCATION=
# THEMUSE_API_KEY=
# THEMUSE_CATEGORIES=Software Engineering

# --- Direct-from-company-site sources (gated by "Allow direct scraping" toggle,
# not the RSS toggle) ---
# Comma-separated board tokens/slugs, found in the company's careers page URL:
#   boards.greenhouse.io/<token>  |  jobs.lever.co/<slug>  |  jobs.ashbyhq.com/<name>
# Empty by default -- nothing is fetched until you add tokens for companies you care about.
# GREENHOUSE_BOARD_TOKENS=stripe,figma
# LEVER_COMPANY_SLUGS=plaid
# ASHBY_BOARD_NAMES=ramp

# Foundit and Unstop -- neither has a public feed; both are queried via their own
# internal listing/search APIs instead (undocumented, more fragile than the
# sources above -- see SOURCES.md before enabling). Both gated by "Allow direct
# scraping". Unstop needs no config beyond the toggle. FOUNDIT_SEARCH_LOCATIONS
# is required for any Foundit adapter to register at all.
# FOUNDIT_SEARCH_QUERIES=java,python,devops
# FOUNDIT_SEARCH_LOCATIONS=pune
# FOUNDIT_SEARCH_COUNTRIES=India
